{
  "name": "emart-ecommerce",
  "version": "1.0.0",
  "description": "A full-stack ecommerce application built with Angular, Node.js, Express, and PostgreSQL",
  "main": "index.js",
  "scripts": {
    "start": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd backend && npm start",
    "start:frontend": "cd Frontend && npm start",
    "install:all": "npm install && cd backend && npm install && cd ../Frontend && npm install",
    "build:frontend": "cd Frontend && npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "ecommerce",
    "angular",
    "nodejs",
    "express",
    "postgresql",
    "tailwindcss",
    "typescript"
  ],
  "author": "E-Mart Team",
  "license": "MIT",
  "dependencies": {
    "cloudinary": "^1.40.0",
    "multer": "^1.4.5-lts.1",
    "nodemon": "^3.0.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-username/emart-ecommerce.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/emart-ecommerce/issues"
  },
  "homepage": "https://github.com/your-username/emart-ecommerce#readme"
}
